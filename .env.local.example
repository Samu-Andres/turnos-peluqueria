# Copiá este archivo a .env.local y completá con los datos de tu proyecto de Supabase
# (Project Settings -> API en el dashboard de Supabase).
# .env.local está en .gitignore, nunca se commitea.

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Service role key (Project Settings -> API -> service_role): NUNCA se
# expone al navegador, solo la usa el servidor para invitar por mail a
# las cuentas de staff (negocios con local propio). Guardala con cuidado.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Dominio público del sitio, sin barra final. En producción es obligatorio
# para que los links de los mails no apunten a localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Avisos por mail al negocio (reserva nueva, cambio o cancelación de un
# cliente) con la API de Brevo. API key: Brevo → SMTP & API → API Keys
# (es distinta de la SMTP key). El remitente tiene que estar verificado en
# Brevo (Senders). Si faltan, la app funciona igual pero no manda avisos.
BREVO_API_KEY=tu-brevo-api-key
BREVO_SENDER_EMAIL=tu-remitente-verificado@gmail.com
