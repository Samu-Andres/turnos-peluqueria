# Copiá este archivo a .env.local y completá con los datos de tu proyecto de Supabase
# (Project Settings -> API en el dashboard de Supabase).
# .env.local está en .gitignore, nunca se commitea.

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Service role key (Project Settings -> API -> service_role): NUNCA se
# expone al navegador, solo la usa el servidor para invitar por mail a
# las cuentas de staff (negocios con local propio). Guardala con cuidado.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
